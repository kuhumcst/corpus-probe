{:paths ["src" "resources"]

 :deps {org.clojure/clojure          {:mvn/version "1.12.0"}
        babashka/process             {:mvn/version "0.6.25"}
        io.pedestal/pedestal.service {:mvn/version "0.8.1"}
        io.pedestal/pedestal.http-kit {:mvn/version "0.8.1"}
        no.cjohansen/replicant         {:mvn/version "2026.07.1"}
        com.cognitect/transit-clj      {:mvn/version "1.0.333"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]}

  :cljs {:extra-deps {thheller/shadow-cljs        {:mvn/version "3.5.0"}
                      com.cognitect/transit-cljs  {:mvn/version "0.8.280"}}}

  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          :main-opts  ["-m" "nrepl.cmdline"]}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}}}
