{:deps   {:aliases [:dev]}
 ;; declared, not defaulted: dev/user.clj reads this port for the
 ;; Content-Security-Policy, and :strict stops it drifting when busy
 :http   {:port 9630 :strict true}
 :builds {:app  {:target     :browser
                 :output-dir "resources/public/js"
                 :asset-path "/js"
                 :modules    {:main {:init-fn dk.cst.corpus-probe.client/init!}}}
          ;; the tests of what both sides build from, and of the client's
          ;; pure step, on the JavaScript host: `shadow-cljs compile
          ;; test`, then `node target/test.js`
          :test {:target    :node-test
                 :output-to "target/test.js"
                 :ns-regexp "(cqp|hiccup|stats|query.*|client.*)-test$"}}}
